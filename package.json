{
  "name": "compact-encoding",
  "version": "3.5.2",
  "description": "A series of compact encoding schemes for building small and fast parsers and serializers",
  "exports": {
    "./package": "./package.json",
    "./package.json": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./endian": {
      "types": "./endian.d.ts",
      "default": "./endian.js"
    },
    "./lexint": {
      "types": "./lexint.d.ts",
      "default": "./lexint.js"
    },
    "./raw": {
      "types": "./raw.d.ts",
      "default": "./raw.js"
    }
  },
  "files": [
    "endian.js",
    "endian.d.ts",
    "index.js",
    "index.d.ts",
    "lexint.js",
    "lexint.d.ts",
    "raw.js",
    "raw.d.ts"
  ],
  "scripts": {
    "format": "prettier --write . && lunte --fix",
    "lint": "prettier --check . && lunte",
    "test": "npm run test:bare && npm run test:node",
    "test:bare": "brittle-bare --coverage test.js",
    "test:node": "brittle-node --coverage test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holepunchto/compact-encoding.git"
  },
  "author": "Mathias Buus (@mafintosh)",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/compact-encoding/issues"
  },
  "homepage": "https://github.com/holepunchto/compact-encoding#readme",
  "dependencies": {
    "b4a": "^1.3.0"
  },
  "devDependencies": {
    "brittle": "^4.0.0",
    "lunte": "^1.8.6",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0"
  }
}
